{
  "name": "updates",
  "version": "20.0.0",
  "description": "CLI to update npm, uv, cargo, go, docker and actions dependencies",
  "author": "silverwind <me@silverwind.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverwind/updates.git"
  },
  "license": "BSD-2-Clause",
  "keywords": [
    "cli",
    "dependencies",
    "update",
    "upgrade",
    "outdated",
    "versions",
    "ncu",
    "npm",
    "uv",
    "cargo",
    "golang",
    "rust",
    "python",
    "github-actions",
    "docker",
    "makefile"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24",
    "bun": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-silverwind": "157.0.0",
    "timerel": "6.0.0",
    "tsdown": "0.23.7",
    "tsdown-config-silverwind": "5.0.0",
    "typescript": "7.0.2",
    "typescript-config-silverwind": "21.0.2",
    "updates-config-silverwind": "4.1.0",
    "versions": "15.5.2",
    "vitest": "5.1.0",
    "vitest-config-silverwind": "13.0.0"
  }
}
